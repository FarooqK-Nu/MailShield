# Local verification service (binds 127.0.0.1 only). No secrets belong here.
PORT=8787
# Dashboard origins. The extension origin is added from EXTENSION_ID.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EXTENSION_ID=oijpcmifakangkecaplidfpgjhhidbop
# Holds hashed session tokens; relative to the repository root.
DATA_DIR=.mailshield
# Registry database (SQLite), relative to DATA_DIR. Holds no messages or private keys.
DB_PATH=mailshield.db
# DNS server IP addresses, comma separated. Empty uses the system resolvers. Set this if the
# service warns that DNS is unreachable (for example to your router address).
DNS_SERVERS=
DNS_TIMEOUT_MS=3000
