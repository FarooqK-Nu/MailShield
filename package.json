{
  "name": "mailshield",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web,ext \"npm run dev -w @mailshield/server\" \"npm run dev -w @mailshield/web\" \"npm run dev -w @mailshield/extension\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "spike:eml": "tsx tools/verify-eml.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
